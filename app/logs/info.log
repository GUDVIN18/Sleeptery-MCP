              "format": "date",
              "type": "string"
            },
            "end_date": {
              "description": "Конец периода анализа сна. Дата строго в формате YYYY-MM-DD, например 2026-09-29. Не может быть раньше start_date.",
              "format": "date",
              "type": "string"
            }
          },
          "required": [
            "user_id",
            "start_date",
            "end_date"
          ],
          "type": "object"
        }
      },
      "required": [
        "data"
      ]
    }
  }
